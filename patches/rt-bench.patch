+    return NULL;
+  }
+  if (current_status >= MEMORY_WATCHER_ENABLED) {
+    res = sem_post(&(memory_watcher_config.mutex));
+    if (res < 0) {
+      perror("Cannot post on memory watcher mutex during calloc");
+      return NULL;
+    }
+  }
+  return pointer;
+}
+
+/// The symbol that corresponds to the real `realloc()`, after the linker has
+/// done the wrapping.
+extern void *__real_realloc(void *p, size_t size);
+
+/// The symbol that corresponds to the armMbed version of `realloc()`, which we
+/// are using when the user requests as fixed size heap.
+extern void *dlrealloc(void *p, size_t size);
+
+/// Make calloc behave the same but use the wrapped malloc got get memory
+void *__wrap_realloc(void *p, size_t size) {
+  int res;
+  elogf(LOG_LEVEL_MEM_TRACE, "wapper realloc with pointer %p size %zu\n", p, size);
+  void *pointer = NULL;
+  enum memory_watcher_states current_status;
+  __atomic_load(&(memory_watcher_config.status), &current_status,
+                __ATOMIC_SEQ_CST);
+  if (current_status >= MEMORY_WATCHER_ENABLED) {
+    res = sem_wait(&(memory_watcher_config.mutex));
+    if (res < 0) {
+      perror("Cannot wait on memory watcher mutex during realloc");
+      return NULL;
+    }
+    // recheck the memory watcher status, in case it was disabled when we were
+    // sleeping
+    __atomic_load(&(memory_watcher_config.status), &current_status,
+                  __ATOMIC_SEQ_CST);
+  }
+  void *(*realloc)(void *, size_t) =
+      (current_status >= MEMORY_WATCHER_INITIALIZING) ? dlrealloc
+                                                      : __real_realloc;
+
+  elogf(LOG_LEVEL_MEM_TRACE, "wrapped realloc mem watcher config status:%d \n",
+        memory_watcher_config.status);
+  elogf(
+      LOG_LEVEL_MEM_TRACE,
+      "wrapped realloc \t real_realloc address: %p, dlrealloc %p, selected: %s "
+      "(%p)\n",
+      __real_realloc, dlrealloc,
+      (realloc == __real_realloc) ? "real_realloc" : "dlrealloc", realloc);
+  pointer = (realloc)(p, size);
+  elogf(LOG_LEVEL_MEM_TRACE, "Allocation done at: %p\n", pointer);
+  if (translate_va((u64)pointer) < 0) {
+    elogf(LOG_LEVEL_ERR, "Cannot translate pointer %p\n", pointer);
+    sem_post(&(memory_watcher_config.mutex));
+    return NULL;
+  }
+  if (current_status >= MEMORY_WATCHER_ENABLED) {
+    res = sem_post(&(memory_watcher_config.mutex));
+    if (res < 0) {
+      perror("Cannot post on memory watcher mutex during realloc");
+      return NULL;
+    }
+  }
+  return pointer;
+}
+
+/// The symbol that correspond to the real version of strdup
+extern char *__real_strdup(const char *s);
+
+/// Out version of strdup, so that it can use the memory watcher
+char *__wrap_strdup(const char *s) {
+  int len = strlen(s);
+  char *newstr = __wrap_calloc(len + 1, sizeof(char));
+  if (newstr != NULL) {
+    strcpy(newstr, s);
   }
+  return newstr;
 }
